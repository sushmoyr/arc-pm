{
  "name": "arc-pm",
  "version": "0.2.0",
  "description": "ARC: Local-first, AI-agent-optimized project management CLI.",
  "type": "module",
  "bin": {
    "arc": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node ./scripts/copy-assets.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "project-management",
    "task-management",
    "jira",
    "tui",
    "ai-agents",
    "llm",
    "local-first",
    "sqlite"
  ],
  "author": "Sushmoy Roy",
  "license": "MIT",
  "homepage": "https://github.com/sushmoyr/arc-pm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sushmoyr/arc-pm.git"
  },
  "bugs": {
    "url": "https://github.com/sushmoyr/arc-pm/issues"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.5"
  }
}
